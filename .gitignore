# Agent-Dev-Kit .gitignore

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Antigravity-specific
.antigravityignore

# Archive
_archive/

# Internal docs (research, roadmap - local only)
docs/

# Project-specific context
context/
AGENTS.md
AGENT.md
rule-overrides.approved.md

# Analysis reports
GRAPH_REPORT*.md
.codegraph/

# AI Generated Artifacts
task*.md
walkthrough*.md
implementation_plan*.md
clarify-record*.md
delivery-report*.md

# Agent runtime & local artifacts
.agents/
.agent/

# Environment / IDE hidden
.env
.env.*
.gemini/
.cursor/

# Node modules
node_modules/

# Logs
*.log
CHANGELOG.md

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Local developer overrides
*.local.md
.agents/*.local.md