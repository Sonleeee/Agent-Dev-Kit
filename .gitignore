# Agent Kit — .gitignore

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Antigravity-specific (không share qua repo)
.antigravityignore

# Archive (nội dung cũ, không cần thiết trong kit mới)
_archive/

# Internal docs (research, roadmap — chỉ giữ local, không push)
docs/

# Project-specific context (thuộc về project, không thuộc core kit)
# Thể hiện dữ liệu riêng của dự án, KHÔNG push lên repo Agent-Dev-Kit
context/
AGENTS.md
AGENT.md
rule-overrides.approved.md

# Kết quả phân tích (Từ các addon như Graphify)
GRAPH_REPORT*.md

# AI Generated Artifacts (Tránh push nhầm file sinh ra lúc làm việc)
task*.md
walkthrough*.md
implementation_plan*.md
clarify-record*.md
delivery-report*.md
# Agent runtime & local artifacts (ch? d�ng local khi dev kit, kh�ng push l�n repo kit)
.agents/
.agent/

# Môi trường / IDE ẩn
.env
.env.*
.gemini/
.cursor/

# Node modules (nếu có scripts)
node_modules/

# Logs
*.log
CHANGELOG.md



# Python
__pycache__/
*.py[cod]
*$py.class

# Local developer overrides
*.local.md
.agents/*.local.md
