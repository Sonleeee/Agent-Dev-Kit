// Source of truth: Domain/LaborAssessments/Rules/
// Placeholders: {Entity}, {Module}, {RuleName}
// IBusinessRule: enforce invariant trong Domain.
// Rule KHÔNG được inject repository hoặc gọi DB (Violation #2 - DDD).
// Nếu cần check DB (ví dụ Code Unique), hãy dùng Domain Service (Async).
// Domain/{Module}/Rules/{Entity}{RuleName}Rule.cs
using Contracts.Domain.Interfaces;

namespace TLBIOMASS.Domain.{Module}.Rules;

public class {Entity}{RuleName}Rule : IBusinessRule
{
    private readonly string _value;

    public {Entity}{RuleName}Rule(string value)
    {
        _value = value;
    }

    // Error code format: "{Entity}.{RuleName}" — FE dùng key này để dịch i18n
    public string Code => "{Entity}.{RuleName}";
    public string Message => $"{{_value}} is invalid.";

    public bool IsBroken()
    {
        // Chỉ thực hiện logic so khớp/tính toán đồng bộ tại đây
        // Ví dụ: return string.IsNullOrWhiteSpace(_value);
        return false; 
    }
}

