// Infrastructure/Repositories/{ChildEntity}Repository.cs
// Repository cho Child Entity — chứa toàn bộ logic CRUD items + file upload/delete.
// Inject IMediator + IFileStorageRepository, dùng FileStorageHelper cho file operations.
// Dùng base repo FindByCondition cho validate.

using Contracts.Common.Interface;
using Contracts.Exceptions;
using Infrastructure.Common.Repository;
using MediatR;
using Shared.Domain.Enums;
using TLBIOMASS.Application.Common.Helpers;
using TLBIOMASS.Domain.Constants.ErrorMessages;
using TLBIOMASS.Domain.FileStorages.Interfaces;
using TLBIOMASS.Domain.{Module};
using TLBIOMASS.Domain.{Module}.Interfaces;
using TLBIOMASS.Domain.{Module}.ValueObjects;
using TLBIOMASS.Infrastructure.Persistences;

namespace TLBIOMASS.Infrastructure.Repositories;

public class {ChildEntity}Repository : RepositoryBaseAsync<{ChildEntity}, long, TLBIOMASSContext>, I{ChildEntity}Repository
{
    private readonly IFileStorageRepository _fileStorageRepository;
    private readonly IMediator _mediator;

    public {ChildEntity}Repository(
        TLBIOMASSContext dbContext,
        IUnitOfWork<TLBIOMASSContext> unitOfWork,
        IFileStorageRepository fileStorageRepository,
        IMediator mediator)
        : base(dbContext, unitOfWork)
    {
        _fileStorageRepository = fileStorageRepository;
        _mediator = mediator;
    }

    public async Task DeleteRangeAsync(IEnumerable<{ChildEntity}> entities)
    {
        DbContext.Set<{ChildEntity}>().RemoveRange(entities);
    }

    // ──────── Create flow ────────
    public async Task CreateItemsAsync(
        {Entity} entity,
        List<{ValueObject}> items,
        CancellationToken cancellationToken = default)
    {
        var newItems = items.Select(s => {ChildEntity}.Create(
            entity.Id, s.Field1, s.Field2 /* ... */)).ToList();

        entity.AddItems(newItems);
        await SaveChangesAsync(cancellationToken);

        // Upload files cho items mới (cần Id sau save)
        for (int i = 0; i < items.Count; i++)
        {
            if (items[i].Files != null && items[i].Files!.Any())
                await FileStorageHelper.UploadFilesAsync(
                    _mediator, items[i].Files!, newItems[i].Id,
                    FileStorageEntityType.{ChildEntity}, cancellationToken);
        }
    }

    // ──────── Sync (Update) flow ────────
    public async Task SyncItemsAsync(
        {Entity} entity,
        List<{ValueObject}> incomingItems,
        CancellationToken cancellationToken = default)
    {
        var existingItems = entity.Items.ToList();

        // 1. Validate IDs — dùng base repo FindByCondition
        var requestedIds = incomingItems.Where(x => x.Id > 0).Select(x => (long)x.Id!).ToList();
        if (requestedIds.Any())
        {
            var existingIds = FindByCondition(x => requestedIds.Contains(x.Id))
                .Select(x => x.Id).ToHashSet();
            var invalidIds = requestedIds.Where(id => !existingIds.Contains(id)).ToList();

            if (invalidIds.Any())
            {
                throw new BusinessException(
                    {Module}Errors.{ChildEntity}.InvalidItemIds,
                    $"{Module}Errors.{ChildEntity}.InvalidItemIds: [{string.Join(", ", invalidIds)}]");
            }
        }

        // 2. Remove deleted items + unlink files
        var itemsToRemove = existingItems.Where(old => !incomingItems.Any(req => req.Id == old.Id)).ToList();
        if (itemsToRemove.Any())
        {
            foreach (var item in itemsToRemove)
                await _fileStorageRepository.UnlinkImagesFromEntityAsync("{ENTITY_TYPE}", item.Id, cancellationToken);

            entity.RemoveItems(itemsToRemove);
            DbContext.Set<{ChildEntity}>().RemoveRange(itemsToRemove);
        }

        // 3. Update existing items (xóa files cũ + upload files mới)
        foreach (var syncData in incomingItems.Where(x => x.Id > 0))
        {
            var oldItem = existingItems.First(x => x.Id == syncData.Id);
            oldItem.Update(syncData.Field1, syncData.Field2 /* ... */);

            // Xóa files được chỉ định
            if (syncData.RemoveIds != null && syncData.RemoveIds.Any())
                await FileStorageHelper.DeleteFilesAsync(
                    _mediator, _fileStorageRepository, syncData.RemoveIds,
                    oldItem.Id, FileStorageEntityType.{ChildEntity}, cancellationToken);

            // Upload files mới
            if (syncData.Files != null && syncData.Files.Any())
                await FileStorageHelper.UploadFilesAsync(
                    _mediator, syncData.Files, oldItem.Id,
                    FileStorageEntityType.{ChildEntity}, cancellationToken);
        }

        // 4. Create new items
        var createSyncData = incomingItems.Where(x => x.Id is null or <= 0).ToList();
        var newItems = createSyncData.Select(s => {ChildEntity}.Create(
            entity.Id, s.Field1, s.Field2 /* ... */)).ToList();

        if (newItems.Any())
            entity.AddItems(newItems);

        // 5. Recalculate totals
        entity.CalculateTotalAmount();
        entity.UpdatePaymentStatus();

        // 6. Save 1 lần
        await SaveChangesAsync(cancellationToken);

        // 7. Upload files cho items mới (cần Id sau save)
        for (int i = 0; i < createSyncData.Count; i++)
        {
            if (createSyncData[i].Files != null && createSyncData[i].Files!.Any())
                await FileStorageHelper.UploadFilesAsync(
                    _mediator, createSyncData[i].Files!, newItems[i].Id,
                    FileStorageEntityType.{ChildEntity}, cancellationToken);
        }
    }
}
