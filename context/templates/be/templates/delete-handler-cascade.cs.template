// Placeholders: {Entity}, {Module}, {entityLower}
// Pattern: Xóa Parent thủ công kèm xóa Child entities (Tránh lệ thuộc hoàn toàn vào DB Cascade)
// Features/{Module}/Commands/Delete{Entity}/Delete{Entity}CommandHandler.cs
using MediatR;
using TLBIOMASS.Domain.{Module}.Interfaces;
using Shared.Exceptions;

namespace TLBIOMASS.Application.Features.{Module}.Commands.Delete{Entity};

public class Delete{Entity}CommandHandler : IRequestHandler<Delete{Entity}Command, bool>
{
    private readonly I{Entity}Repository _{entityLower}Repository;
    // BỔ SUNG: Inject Repository của Entity Con nếu đây là Aggregate Root phức tạp
    // private readonly IChildEntityRepository _childRepository;

    public Delete{Entity}CommandHandler(
        I{Entity}Repository {entityLower}Repository
        /*, IChildEntityRepository childRepository*/)
    {
        _{entityLower}Repository = {entityLower}Repository;
        // _childRepository = childRepository;
    }

    public async Task<bool> Handle(Delete{Entity}Command request, CancellationToken cancellationToken)
    {
        // P9: return false nếu không có data (Để controller trả về 404/200 OK tuỳ thiết kế)
        var entity = await _{entityLower}Repository.GetByIdAsync(request.Id, cancellationToken);
        if (entity == null)
            return false;

        // BƯỚC QUAN TRỌNG VỚI AGGREGATE ROOT
        // 1. Phải xóa child entity thủ công trước (Nếu Db không thiết lập Cascade Delete cứng hoặc cần log)
        /*
        var childsQuery = _childRepository.FindByCondition(c => c.ParentId == request.Id, false);
        var childs = await _childRepository.FindListAsync(childsQuery, cancellationToken);
        foreach(var child in childs) {
            _childRepository.Delete(child);
        }
        */

        // 2. Xóa Parent Entity
        await _{entityLower}Repository.DeleteAsync(entity, cancellationToken);
        
        // 3. SaveChanges 1 lần duy nhất cho toàn bộ giao dịch
        await _{entityLower}Repository.SaveChangesAsync(cancellationToken);
        
        return true;
    }
}
