// Placeholders: {Entity}, {Module}
// KHÔNG dùng IRegister.
// Mỗi nhóm mapping tách thành 1 file trong Common/Mappings/Mapster.
//
// Rule chọn API:
// - Map(...) = map từng field đơn giản.
// - MapWith(...) = tự tạo cả object đích, hợp với record/immutable hoặc logic compose.
// - ConstructUsing(...) = tạo domain object qua factory method.
// - AfterMapping(...) = xử lý bổ sung sau khi map xong.

// --- Bước 1: Tạo file mapping module ---
// File: Common/Mappings/Mapster/{Module}Mappings.cs
using Mapster;
using Shared.DTOs.{Module};
using TLBIOMASS.Application.Features.{Module}.Commands.Update{Entity};
using TLBIOMASS.Domain.{Module};

namespace TLBIOMASS.Application.Common.Mappings.Mapster;

internal static class {Module}Mappings
{
    public static void Configure()
    {
        TypeAdapterConfig<{Entity}, {Entity}ResponseDto>.NewConfig()
            .Map(dest => dest.Status, src => src.Status.ToString());

        // Nếu UpdateDto.Status là Optional<EntityStatus> thì map trực tiếp,
        // KHÔNG parse qua string helper.
        TypeAdapterConfig<{Entity}UpdateDto, Update{Entity}Command>.NewConfig()
            .Map(dest => dest.Status, src => src.Status);

        // Nếu destination là record/immutable hoặc cần custom constructor:
        // TypeAdapterConfig<{Entity}PagedFilterDto, {Entity}PagedFilterSpec>.NewConfig()
        //     .MapWith(src => new {Entity}PagedFilterSpec(
        //         src.Q,
        //         src.Status,
        //         src.PageNumber,
        //         src.PageSize
        //     ));

        // Nếu domain object phải đi qua factory method:
        // TypeAdapterConfig<{Entity}CreateDto, {Entity}>.NewConfig()
        //     .ConstructUsing(src => {Entity}.Create(...));
    }
}

