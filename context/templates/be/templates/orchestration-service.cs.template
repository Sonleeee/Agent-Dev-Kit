// Application/Features/{Module}/Services/{Entity}OrchestrationService.cs
// Service điều phối: Load data -> Call Domain Logic -> Save results.
// Inject Repositories + Domain Services.
// Chịu trách nhiệm về Unit of Work (vòng đời Transaction).

using Mapster;
using Shared.DTOs.{Module};
using TLBIOMASS.Application.Common.Interfaces;
using TLBIOMASS.Domain.{Module};
using TLBIOMASS.Domain.{Module}.Interfaces;
using TLBIOMASS.Domain.{Module}.Services;
using TLBIOMASS.Domain.{Module}.ValueObjects;

namespace TLBIOMASS.Application.Features.{Module}.Services;

public class {Entity}OrchestrationService : I{Entity}OrchestrationService
{
    private readonly I{Entity}Repository _{entityLower}Repository;
    private readonly I{Entity}DomainService _{entityLower}DomainService;
    private readonly ICodeGenerator _codeGenerator;

    public {Entity}OrchestrationService(
        I{Entity}Repository {entityLower}Repository,
        I{Entity}DomainService {entityLower}DomainService,
        ICodeGenerator codeGenerator)
    {
        _{entityLower}Repository = {entityLower}Repository;
        _{entityLower}DomainService = {entityLower}DomainService;
        _codeGenerator = codeGenerator;
    }

    public async Task<{Entity}ProcessResult> ProcessDataAsync(
        List<{Entity}DTO> dtos,
        CancellationToken ct)
    {
        // 1. Fetch Dữ liệu liên quan từ các Repositories (I/O)
        var existingData = await _{entityLower}Repository.GetByConditionAsync(x => /* ... */, ct);
        
        // 2. Chuyển giao Logic cho Domain Service (Pure Logic)
        var domainResult = _{entityLower}DomainService.Process(dtos, existingData);

        // 3. Thực thi lưu trữ các thay đổi (I/O)
        if (domainResult.NewItems.Any())
        {
            await _{entityLower}Repository.AddRangeAsync(domainResult.NewItems, ct);
        }

        foreach (var item in domainResult.UpdatedItems)
        {
            await _{entityLower}Repository.UpdateAsync(item, ct);
        }

        // 4. SaveChanges một lần duy nhất để kết thúc Transaction
        await _{entityLower}Repository.SaveChangesAsync(ct);

        return new {Entity}ProcessResult { Success = true };
    }
}
