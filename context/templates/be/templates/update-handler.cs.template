// Features/{Module}/Commands/Update{Entity}/Update{Entity}CommandHandler.cs
using MediatR;
using TLBIOMASS.Domain.{Module}.Interfaces;
using Shared.Interfaces;
using Contracts.Exceptions;
using Mapster;

namespace TLBIOMASS.Application.Features.{Module}.Commands.Update{Entity};

public class Update{Entity}CommandHandler : IRequestHandler<Update{Entity}Command, bool>
{
    private readonly I{Entity}Repository _{entityLower}Repository;
    private readonly IFileStorageRepository _fileStorageRepository;

    public Update{Entity}CommandHandler(
        I{Entity}Repository {entityLower}Repository,
        IFileStorageRepository fileStorageRepository)
    {
        _{entityLower}Repository = {entityLower}Repository;
        _fileStorageRepository = fileStorageRepository;
    }

    public async Task<bool> Handle(Update{Entity}Command request, CancellationToken cancellationToken)
    {
        // P9: return false nếu không tìm thấy — KHÔNG throw NotFoundException trong Command
        var entity = await _{entityLower}Repository.GetByIdWithDetailsAsync(request.Id, cancellationToken);
        if (entity == null)
            return false;

        // 1. Uniqueness check nếu thay đổi Code (Violation #2)
        if (request.Code.HasValue && request.Code.Value != entity.Code)
        {
            var exists = await _{entityLower}Repository.CheckExistsAsync(x => x.Code == request.Code.Value && x.Id != entity.Id, cancellationToken);
            if (exists) throw new DuplicateException(nameof({Entity}), nameof(request.Code), request.Code.Value);
        }

        // 2. Mapster resolve Optional<T>
        request.Adapt(entity);

        await _{entityLower}Repository.UpdateAsync(entity, cancellationToken);
        
        // 3. SaveChanges
        await _{entityLower}Repository.SaveChangesAsync(cancellationToken);

        // 4. Link/Unlink file đính kèm
        if (request.FileIds.HasValue)
        {
            await _fileStorageRepository.UnlinkImagesFromEntityAsync("{ENTITY_TYPE}", entity.Id, cancellationToken);
            if (request.FileIds.Value != null && request.FileIds.Value.Any())
            {
                await _fileStorageRepository.LinkImagesToEntityAsync(request.FileIds.Value, "{ENTITY_TYPE}", entity.Id, cancellationToken);
            }
        }

        return true;
    }
}
