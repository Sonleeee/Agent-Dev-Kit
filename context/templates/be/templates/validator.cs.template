using FluentValidation;
using Contracts.Domain.Enums;

namespace TLBIOMASS.Application.Features.{Module}.Commands.Create{Entity};

public class Create{Entity}Validator : AbstractValidator<Create{Entity}Command>
{
    public Create{Entity}Validator()
    {
        RuleFor(x => x.Code)
            .NotEmpty().WithMessage({Module}Errors.{Entity}.CodeRequired)
            .MaximumLength(50).WithMessage({Module}Errors.{Entity}.CodeTooLong);

        RuleFor(x => x.Name)
            .NotEmpty().WithMessage({Module}Errors.{Entity}.NameRequired)
            .MaximumLength(200).WithMessage({Module}Errors.{Entity}.NameTooLong);

        // Enum validation example cho Optional<EntityStatus>:
        // RuleFor(x => x.Status.Value)
        //     .Must(status => Enum.IsDefined(typeof(EntityStatus), status))
        //     .WithMessage("Status is invalid")
        //     .When(x => x.Status.HasValue);
    }
}
