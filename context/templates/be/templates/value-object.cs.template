// Domain/{Module}/ValueObjects/{ValueObject}.cs
// ValueObject trung gian: Service map DTO→{ValueObject}, repo nhận thay vì DTO từ Shared.
// Tên {ValueObject} tùy nghiệp vụ, ví dụ: PaymentItemInput, ContractLineDetail, OrderEntry...

using Shared.DTOs.FileStorage;

namespace TLBIOMASS.Domain.{Module}.ValueObjects;

public record {ValueObject}(
    long? Id,          // null hoặc <= 0 = tạo mới, > 0 = update, missing trong list = xóa
    long? Field1,
    string? Field2,
    // ... các field cần thiết cho child entity
    List<FileUploadDto>? Files = null,   // IFormFile files cần upload (nullable, bỏ nếu không có file)
    List<long>? RemoveIds = null);       // IDs file cần xóa khi update (nullable, bỏ nếu không có file)
