import { Breadcrumbs, Button, DataTable, MainCard, TableFetchParams, Text, Tabs } from '@components';
import { Grid, Stack, Box } from '@mui/material';
import { routes } from '@routes';
import { useRouter, useDialog, useTrigger, useToast } from '@hooks';
import { useState } from 'react';
import { PagedResult } from '@services/core';
import { {{serviceExportName}}, List{{PascalName}}Response } from '@services/{{serviceFolder}}';
import { locales } from '@locales';
import { DEFAULT_PAGED_RESULT } from '@utils/constants';
import { DeleteOutlined, EditOutlined, EyeOutlined, PlusOutlined } from '@ant-design/icons';
import { ColumnDef } from '@tanstack/react-table';

const List{{PascalName}} = () => {
  const router = useRouter();
  const dialog = useDialog();
  const toast = useToast();
  const { trigger, onRefresh } = useTrigger();

  const [data, setData] = useState<PagedResult<List{{PascalName}}Response>>(DEFAULT_PAGED_RESULT);
  const [currentTab, setCurrentTab] = useState('all');

  const handleFetchData = async (params: TableFetchParams) => {
    // P17: params.page đã là 0-indexed, DataTable tự handle +1 khi hiển thị
    const response = await {{serviceExportName}}.listPaged{{PascalName}}({
      pageNumber: params.page,
      pageSize: params.pageSize,
      q: params.search,
      status: currentTab === 'all' ? undefined : currentTab
    });

    if (response.success && response.data) {
      setData(response.data);
    }
  };

  const handleDelete = async (id: number) => {
    const result = await dialog.confirm({
      title: locales.buttons.delete,
      description: locales.common.deletion.description,
      label: {
        accept: locales.buttons.delete,
        cancel: locales.buttons.cancel
      }
    });

    if (result?.success) {
      const response = await {{serviceExportName}}.delete{{PascalName}}(id);
      if (response.success) {
        toast.success(locales.common.deletion.success);
        onRefresh();
      } else {
        toast.error(response.errors?.[0] ?? locales.common.deletion.error);
      }
    }
  };

  // ============================
  // == COLUMNS DEFINITION ==
  // ============================
  const columns: ColumnDef<List{{PascalName}}Response>[] = [
    // TODO: chỉnh columns theo module
    { header: locales.tables.columns.code, accessorKey: 'code' },
    { header: locales.inputs.name, accessorKey: 'name' },
    {
      header: locales.tables.columns.status,
      accessorKey: 'status',
      cell: ({ row }) => <Text.Label color="info" label={row.original.status ?? ''} size="small" />
    },
    {
      header: locales.tables.columns.actions,
      id: 'actions',
      cell: ({ row }) => {
        const item = row.original;
        return (
          <Stack direction="row" spacing={0.5}>
            <Button.Icon tooltip={locales.common.button.viewDetail} color="secondary" onClick={() => router.push(routes.{{routePath}}.detail(item.id))}>
              <EyeOutlined />
            </Button.Icon>
            <Button.Icon tooltip={locales.buttons.edit} color="primary" onClick={() => router.push(routes.{{routePath}}.edit(item.id))}>
              <EditOutlined />
            </Button.Icon>
            <Button.Icon tooltip={locales.buttons.delete} color="error" onClick={() => handleDelete(item.id)}>
              <DeleteOutlined />
            </Button.Icon>
          </Stack>
        );
      }
    }
  ];

  const breadcrumbLinks = [
    { title: locales.breadcrumbs.home, to: routes.default },
    { title: locales.breadcrumbs.dashboard, to: routes.dashboard.base },
    { title: locales.breadcrumbs.{{breadcrumbKey}} }
  ];

  return (
    <>
      <Breadcrumbs heading={locales.breadcrumbs.{{breadcrumbKey}}} links={breadcrumbLinks} />

      {/* Pattern: Tabs.Panel cho module nhiều trạng thái/loại dữ liệu */}
      <Box sx={{ borderBottom: 1, borderColor: 'divider', mb: 2 }}>
        <Tabs.Panel
          tabs={[
            { label: locales.common.all, value: 'all' },
            { label: locales.common.active, value: 'active' },
            { label: locales.common.inactive, value: 'inactive' }
          ]}
          value={currentTab}
          onChange={(val) => {
            setCurrentTab(val);
            onRefresh();
          }}
        />
      </Box>

      <Grid container spacing={2}>
        <Grid size={12}>
          <MainCard>
              <DataTable
                data={data.items}
                columns={columns}
                totalPage={data.pagination?.totalPages || 1}
                onLoad={handleFetchData}
                triggers={{ trigger }}
                slots={{
                  action: (
                    <Button.Base
                      variant="contained"
                      startIcon={<PlusOutlined />}
                      onClick={() => router.push(routes.{{routePath}}.create)}
                      label={locales.buttons.createNew}
                    />
                  )
                }}
              />
          </MainCard>
        </Grid>
      </Grid>
    </>
  );
};

export default List{{PascalName}};
