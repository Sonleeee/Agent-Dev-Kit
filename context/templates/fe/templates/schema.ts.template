import { 
  dateTimeSchemaOptional, 
  dateTimeSchemaRequired, 
  emailSchemaRequired, 
  moneySchema, 
  phoneSchema,
  fileSchemaRequired
} from '@forms';
import zod from 'zod';

// TODO: cập nhật schema theo module thực tế
export const schema = zod.object({
  code: zod.string().min(1, 'Bắt buộc nhập').max(50),
  name: zod.string().min(1, 'Bắt buộc nhập').max(200),
  email: emailSchemaRequired,
  phoneNumber: phoneSchema,
  price: moneySchema,
  // ngày bắt buộc: dateTimeSchemaRequired — dùng cho DatePicker (P11)
  // ngày tùy chọn: dateTimeSchemaOptional — dùng cho DatePicker (P11)
  // tệp đính kèm: fileSchemaRequired
});

export type FormProps = zod.infer<typeof schema>;
