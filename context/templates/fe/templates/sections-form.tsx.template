import { Grid } from '@mui/material';
import { Accordion, Button } from '@components';
import { Form, FormField, useFormResolver } from '@forms';
import { SaveOutlined } from '@ant-design/icons';
import { locales } from '@locales';
import { schema, FormProps } from '../schema';

type Props = {
  mode: PageMode;
  onSubmit: (values: FormProps) => Promise<void>;
  defaultValues?: Partial<FormProps>;
};

const FormSection = ({ mode, onSubmit, defaultValues }: Props) => {
  const isDetail = mode === 'detail';

  const form = useFormResolver(schema, { defaultValues: defaultValues ?? {} });
  // ← ĐÚNG: isSubmitting khai báo SAU useFormResolver (P1)
  const { formState: { isSubmitting } } = form;

  return (
    <Accordion title={locales.common.title.generalInfo} canExpand={false}>
      <Form methods={form} onSubmit={onSubmit}>
        <Grid container spacing={2}>
          {/* Text Field */}
          <Grid size={{ xs: 12, md: 6 }}>
            <FormField.Text name="code" label={locales.inputs.code} required disabled={isDetail} />
          </Grid>
          
          {/* Autocomplete - P16: onChange chỉ nhận 1 tham số */}
          <Grid size={{ xs: 12, md: 6 }}>
            <FormField.Autocomplete
              name="categoryId"
              label={locales.inputs.category}
              options={[]} // TODO: truyền options thực tế
              required
              disabled={isDetail}
            />
          </Grid>

          {/* Decimal Field */}
          <Grid size={{ xs: 12, md: 6 }}>
            <FormField.Decimal
              name="price"
              label={locales.inputs.price}
              required
              disabled={isDetail}
            />
          </Grid>

          {/* Date Picker - P11: Phải dùng schema phù hợp */}
          <Grid size={{ xs: 12, md: 6 }}>
            <FormField.DatePicker
              name="effectiveDate"
              label={locales.inputs.date}
              required
              disabled={isDetail}
            />
          </Grid>

          {/* File Upload */}
          <Grid size={12}>
            <FormField.FileUpload
              name="documents"
              label={locales.inputs.files}
              multiple
              disabled={isDetail}
            />
          </Grid>

          {!isDetail && (
            <Grid size={12} container justifyContent="flex-end">
              {/* P18: PHẢI có disabled={isSubmitting} chống double submit */}
              <Button.Base
                type="submit"
                label={locales.buttons.save}
                startIcon={<SaveOutlined />}
                variant="contained"
                disabled={isSubmitting}
              />
            </Grid>
          )}
          {isDetail && (
            <Grid size={12} container justifyContent="flex-end">
              <Button.Base
                label={locales.buttons.edit}
                variant="contained"
                onClick={() => {/* navigate to edit mode */}}
              />
            </Grid>
          )}
        </Grid>
      </Form>
    </Accordion>
  );
};

export default FormSection;
