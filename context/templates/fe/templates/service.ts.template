import httpClient from '@libs/axios';
import { BaseService, getEndpoints, ApiResult } from '@services/core';
import { callApi } from '@services/core/utils';
import { Create{{PascalName}}Request, List{{PascalName}}Request, Update{{PascalName}}Request } from './request';
import { List{{PascalName}}Response } from './response';

class Service extends BaseService {
  // Paged list
  listPaged{{PascalName}} = (query: List{{PascalName}}Request) =>
    this.paged<List{{PascalName}}Response>(getEndpoints().{{endpointKey}}.paged, query);

  // Detail
  get{{PascalName}}ById = (id: number) =>
    this.get<List{{PascalName}}Response>(getEndpoints().{{endpointKey}}.detail(id));

  // Create
  create{{PascalName}} = (payload: Create{{PascalName}}Request) =>
    this.post<Create{{PascalName}}Request, boolean>(getEndpoints().{{endpointKey}}.create, payload);

  // Update
  update{{PascalName}} = (id: number, payload: Update{{PascalName}}Request) =>
    this.put<Update{{PascalName}}Request, boolean>(getEndpoints().{{endpointKey}}.update(id), payload);

  // Delete
  delete{{PascalName}} = (id: number) =>
    this.delete<boolean>(getEndpoints().{{endpointKey}}.delete(id));

  // Multipart/Upload (P15)
  uploadFiles = (files: File[]) => {
    const formData = new FormData();
    files.forEach((file) => formData.append('Files', file));

    return callApi<boolean>(
      httpClient.post(getEndpoints().{{endpointKey}}.upload, formData, {
        headers: { 'Content-Type': 'multipart/form-data' }
      })
    );
  };
}

export default new Service();
